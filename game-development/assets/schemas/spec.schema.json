{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec-First Guardian",
  "type": "object",
  "required": ["spec_id", "status"],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "UNDER_REVIEW", "PENDING_USER_APPROVAL", "APPROVED", "REJECTED", "SUPERSEDED", "ARCHIVED"]
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date"
    }
  }
}
